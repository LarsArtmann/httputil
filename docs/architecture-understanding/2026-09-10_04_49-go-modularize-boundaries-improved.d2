# httputil target architecture: boundaries held, moves trigger-gated.
# Solid = shipped and verified. Dashed amber = trigger-gated (NOT scheduled without its trigger).
# Render: nix develop -c d2 --layout elk <input> <output>
direction: down

legend: Reading guide {
  solid: "shipped + verified (builds, consumers, CI)" {
    style.stroke: "#111111"
  }
  gated: exists only if its trigger fires {
    style.stroke: "#d97706"
    style.stroke-dash: 4
  }
}

consumers: Consumers (verified via pkg.go.dev importer scan) {
  shape: person
  infamily: 4 owner repos import root
  cqrs: cqrs-htmx imports server_timing standalone
  thirdparty: "third-party adoption: none yet (discovery gap, not architecture gap)"
}

root: Root module github.com/larsartmann/httputil — BOUNDARIES HELD {
  pkg: "package httputil (flat; revisit only at >50 files or v1.0 + internal/ request)" {
    mw: 14 middleware factories
    compose: Composition API front door
    life: Server + Health
    errs: Error model (sentinels live with the code that throws them)
  }
  httpspec: package httpspec {
    label: "package httpspec\nstays a subpackage\nmodule split needs a consumer\nthat needs independent versioning"
    style.stroke: "#1d4ed8"
  }
  internal: internal/ hygiene step {
    style.stroke: "#d97706"
    style.stroke-dash: 4
  }
}

st: server_timing sub-module (zero deps, independent tags) {
  style.stroke: "#1d4ed8"
}

gocompress: go-compression module {
  label: "go-compression module\nextract ONLY when go-datastar\nSSE-compression need lands\n(plan: docs/planning 2026-08-16)"
  style.stroke: "#d97706"
  style.stroke-dash: 4
}

ext: External deps (plugin seams or adapters) {
  shape: cloud
  errf: go-error-family
  xtime: golang.org/x/time
  nosurf: justinas/nosurf
  goetag: go-etag
}

consumers.infamily -> root.pkg: one import path
consumers.cqrs -> st: standalone import
consumers.thirdparty -> root.pkg: arrives via discovery (README, docs site)

root.pkg -> st: replace => ./server_timing
root.pkg.mw -> ext: seams only
root.pkg.compose -> ext.goetag: Middleware alias composition
root.httpspec -> root.pkg: same module

gocompress -> root.pkg.mw: provides WriterFactory plugins to Compression() when extracted {
  style.stroke: "#d97706"
  style.stroke-dash: 4
}
consumers.thirdparty -> gocompress: imports compression without middleware {
  style.stroke: "#d97706"
  style.stroke-dash: 4
}
root.internal -> root.pkg: invisible outside the module (internal/ rule) {
  style.stroke: "#d97706"
  style.stroke-dash: 4
}
